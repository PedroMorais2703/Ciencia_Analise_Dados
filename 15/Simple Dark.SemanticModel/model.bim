        "partitions": [
          {
            "name": "Worksheet",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = Excel.Workbook(File.Contents(\"G:\\python\\Ciencia_Analise_Dados\\15\\dados_ecommerce_final.xlsx\"), null, true),",
                "    Worksheet_Sheet = Fonte{[Item=\"Worksheet\",Kind=\"Sheet\"]}[Data],",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(Worksheet_Sheet, [PromoteAllScalars=true]),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Cabeçalhos Promovidos\",{{\"id_client\", Int64.Type}, {\"Category\", type text}, {\"Price\", type number}, {\"Card Type\", type text}, {\"state_name\", type text}, {\"First_name\", type text}, {\"Gender\", type text}, {\"Job_Title\", type text}, {\"Id_client\", Int64.Type}}),",
                "    #\"Colunas Renomeadas\" = Table.RenameColumns(#\"Tipo Alterado\",{{\"Id_client\", \"Id_client.1\"}}),",
                "    #\"Colunas Removidas\" = Table.RemoveColumns(#\"Colunas Renomeadas\",{\"Id_client.1\"})",
                "in",
                "    #\"Colunas Removidas\""
              ],
              "type": "m"
            }
          }
        ]
