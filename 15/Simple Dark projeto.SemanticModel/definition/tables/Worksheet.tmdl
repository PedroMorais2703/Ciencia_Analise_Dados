table Worksheet
	lineageTag: ff986566-3e14-42c3-bd87-77a240a81f88

	measure Total_Clientes = DISTINCTCOUNT(Worksheet[id_client])
		formatString: 0
		lineageTag: da23e45d-992d-4f43-aa2a-bb13c251a54f

	measure Total_Transacoes = COUNT('Worksheet'[id_client])
		formatString: 0
		lineageTag: 97b4618e-a631-47b9-80aa-404ffcef0cfa

	measure Total_Vendas = SUM('Worksheet'[Price])
		lineageTag: cfa8d846-b270-4eaf-b42f-42a23caa8147

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ticket_Medio = DIVIDE([Total_Vendas], [Total_Transacoes])
		lineageTag: d427a1e4-5cff-47bd-a14c-2ee0fe484c34

		annotation PBI_FormatHint = {"isGeneralNumber":true}

